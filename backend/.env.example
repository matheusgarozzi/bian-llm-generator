PORT=3000
LLM_API_KEY=
LLM_TEMPERATURE=0
# Temperatura usada só no chat livre (respostas menos repetitivas).
LLM_CHAT_TEMPERATURE=0.7
LLM_TOP_P=1
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=1

# Raciocínio do modelo: "none" desliga o modo de pensar do Qwen 3.5 (recomendado para o modelo formal).
LLM_REASONING_EFFORT=none
